{
  "name": "companylab",
  "version": "1.0.0",
  "description": "AI Company Operating System - Virtual AI Company Desktop App",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "NODE_ENV=development electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.companylab.app",
    "productName": "CompanyLab",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "core/**/*",
      "agents/**/*",
      "backend/**/*",
      "room/**/*",
      "team/**/*",
      "assets/**/*",
      "database/**/*",
      "config/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "assets/icons/icon.ico",
      "uninstallerIcon": "assets/icons/icon.ico"
    }
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "sqlite3": "^5.1.6",
    "three": "^0.128.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "keywords": [
    "ai",
    "agents",
    "company",
    "desktop",
    "electron",
    "3d",
    "multi-agent"
  ],
  "author": "CompanyLab Team",
  "license": "MIT"
}